# Normalize line endings: store as LF in the repo, check out as native on each OS
* text=auto

# Force LF for source files regardless of OS
*.py    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.csv   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf

# Binary files — never touch line endings
*.pkl   binary
*.db    binary
